# Copy this file to .env and fill in the values, then run: docker compose up -d --build
# (.env is git-ignored so your secrets stay local.)

# Your Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Password for the bundled Postgres database (choose any strong value; it is used
# by both the db container and the bot's connection string in docker-compose.yml)
DB_PASSWORD=
